{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/record-upload.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/record",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
